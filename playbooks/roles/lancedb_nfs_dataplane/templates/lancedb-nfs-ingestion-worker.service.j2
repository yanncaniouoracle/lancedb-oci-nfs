[Unit]
Description=Pacemaker LanceDB shared-table ingestion worker
After=network-online.target
[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/opt/oci-lancedb-hybrid
EnvironmentFile=/etc/lancedb-nfs/lancedb.env
# The shared export root is owned by root. The '+' prefix keeps this pre-start
# initialization privileged while the worker itself continues to run as opc.
ExecStartPre=+/usr/bin/install -d -o opc -g opc -m 0775 {{ lancedb_nfs_database_path }}
ExecStart=/opt/oci-lancedb-hybrid/.venv/bin/oci-lancedb-ingestion-worker
Restart=no
